finance.list_billing_profiles  GET /billing/profiles
  List Billing Profiles
  args:
    limit       integer int32
    cursor      string
    cluster_id  integer int64
    unit_id     integer int64
    user_id     integer int64
  returns profiles.ListResponse: {has_next_page boolean, hash string, next_cursor string, profiles Profile[]}
  see also: Profile, profiles.ListResponse

