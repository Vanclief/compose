{
  "components": {
    "schemas": {
      "fixture.Config": {
        "properties": {
          "retries": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "fixture.CreateRequest": {
        "properties": {
          "config": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/fixture.Config"
              },
              {
                "type": "null"
              }
            ]
          },
          "labels": {
            "additionalProperties": {
              "$ref": "#/components/schemas/fixture.Config"
            },
            "type": "object"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/fixture.Config"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "fixture.HealthResponse": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "fixture.ListResponse": {
        "properties": {
          "has_next_page": {
            "type": "boolean"
          },
          "hash": {
            "type": "string"
          },
          "next_cursor": {
            "type": "string"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/fixture.Run"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "runs",
          "has_next_page"
        ],
        "type": "object"
      },
      "fixture.Run": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "failure_reason": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "max_total_runs": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/fixture.RunStatus"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "max_total_runs",
          "created_at"
        ],
        "type": "object"
      },
      "fixture.RunStatus": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "type": "string"
      },
      "fixture.UpdateRequest": {
        "properties": {
          "code_snapshot_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "max_total_runs": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/fixture.RunStatus",
                "enum": [
                  "failed",
                  "cancelled"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "fixture.UploadResponse": {
        "properties": {
          "files": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "manifest": {
            "type": "string"
          }
        },
        "required": [
          "manifest",
          "files"
        ],
        "type": "object"
      },
      "handler.ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/handler.StandardError"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "handler.StandardError": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKey": {
        "in": "header",
        "name": "API-KEY",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "fixture API",
    "title": "auditor3",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "deprecated": true,
        "operationId": "health.check",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/fixture.HealthResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/handler.ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/runs": {
      "get": {
        "description": "Cursor paginated.",
        "operationId": "runs.list",
        "parameters": [
          {
            "description": "Page size, defaults to 50",
            "in": "query",
            "name": "limit",
            "schema": {
              "format": "int64",
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from the previous page",
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "project_id",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "$ref": "#/components/schemas/fixture.RunStatus"
            }
          },
          {
            "in": "query",
            "name": "at",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-since",
            "schema": {
              "format": "date-time-http",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/fixture.ListResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/handler.ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "List runs",
        "tags": [
          "runs"
        ]
      },
      "post": {
        "operationId": "runs.create",
        "parameters": [
          {
            "in": "header",
            "name": "x-trace",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/fixture.CreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/fixture.Run"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/handler.ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/export": {
      "get": {
        "operationId": "runs.export",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "$ref": "#/components/schemas/fixture.RunStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/fixture.ListResponse"
                }
              },
              "text/csv": {
                "schema": {
                  "contentMediaType": "application/octet-stream",
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/handler.ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{id}": {
      "get": {
        "operationId": "runs.get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/fixture.Run"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/handler.ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "runs"
        ]
      },
      "patch": {
        "operationId": "runs.update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/fixture.UpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/fixture.Run"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/handler.ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{id}/artifacts": {
      "post": {
        "operationId": "runs.upload",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "attempt": {
                    "format": "int64",
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "category": {
                    "enum": [
                      "log",
                      "report"
                    ],
                    "type": "string"
                  },
                  "files": {
                    "items": {
                      "contentMediaType": "application/octet-stream",
                      "format": "binary",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "manifest": {
                    "contentMediaType": "application/octet-stream",
                    "description": "Run manifest",
                    "format": "binary",
                    "type": "string"
                  },
                  "tags": {
                    "items": {
                      "type": "string"
                    },
                    "type": [
                      "array",
                      "null"
                    ]
                  }
                },
                "required": [
                  "category",
                  "manifest"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/fixture.UploadResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/handler.ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{id}/report": {
      "get": {
        "operationId": "runs.report",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {
                "schema": {
                  "contentMediaType": "application/octet-stream",
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/handler.ErrorResponse"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "runs"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "runs"
    }
  ]
}
